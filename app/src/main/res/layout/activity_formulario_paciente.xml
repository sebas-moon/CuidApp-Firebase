<?xml version="1.0" encoding="utf-8"?>
<!-- NUEVO: FORMULARIO DE PACIENTE (CREATE y UPDATE) -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnVolverFormulario"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/desc_volver"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:id="@+id/tvTituloFormulario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/form_titulo_nuevo"
                android:textColor="@color/text_primary"
                android:textSize="26sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- NUEVO: escanear la cédula con la cámara (ML Kit lee el texto en el teléfono) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEscanearCedula"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="8dp"
            android:text="@string/btn_escanear_cedula"
            android:textColor="@color/accent_stand"
            app:cornerRadius="16dp"
            app:strokeColor="@color/accent_stand" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/escanear_ayuda"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp"
                app:strokeColor="@color/chip_background"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="@string/form_seccion_paciente"
                        android:textColor="@color/accent_stand"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilNombre"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="@string/hint_nombre_paciente"
                        android:textColorHint="@color/text_secondary"
                        app:boxStrokeColor="@color/accent_purple"
                        app:hintTextColor="@color/accent_purple">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etNombre"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPersonName|textCapWords"
                            android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilRut"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="@string/hint_rut"
                        android:textColorHint="@color/text_secondary"
                        app:boxStrokeColor="@color/accent_purple"
                        app:hintTextColor="@color/accent_purple">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etRut"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:digits="0123456789kK-"
                            android:inputType="textCapCharacters|textNoSuggestions"
                            android:maxLength="10"
                            android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilEdad"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="@string/hint_edad"
                        android:textColorHint="@color/text_secondary"
                        app:boxStrokeColor="@color/accent_purple"
                        app:hintTextColor="@color/accent_purple">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etEdad"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLength="3"
                            android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilSexo"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="@string/hint_sexo"
                        android:textColorHint="@color/text_secondary"
                        app:boxStrokeColor="@color/accent_purple"
                        app:hintTextColor="@color/accent_purple">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/etSexo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilPeso"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="@string/hint_peso"
                        android:textColorHint="@color/text_secondary"
                        app:boxStrokeColor="@color/accent_purple"
                        app:hintTextColor="@color/accent_purple">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPeso"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:digits="0123456789.,"
                            android:inputType="numberDecimal"
                            android:maxLength="5"
                            android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilEstatura"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="@string/hint_estatura"
                        android:textColorHint="@color/text_secondary"
                        app:boxStrokeColor="@color/accent_purple"
                        app:hintTextColor="@color/accent_purple">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etEstatura"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:digits="0123456789,"
                            android:inputType="number"
                            android:maxLength="4"
                            android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilSangre"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="@string/hint_sangre"
                        android:textColorHint="@color/text_secondary"
                        app:boxStrokeColor="@color/accent_purple"
                        app:hintTextColor="@color/accent_purple">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/etSangre"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilAlergias"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="@string/hint_alergias"
                        android:textColorHint="@color/text_secondary"
                        app:boxStrokeColor="@color/accent_purple"
                        app:hintTextColor="@color/accent_purple">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etAlergias"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapSentences"
                            android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- NUEVO: condiciones clínicas (definen qué pide el registro diario) -->
            <!-- NUEVO: datos de la cédula de identidad (opcionales; se llenan solos al escanear) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp"
                app:strokeColor="@color/chip_background"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="@string/form_seccion_documento"
                        android:textColor="@color/accent_stand"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="@string/form_documento_ayuda"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilNacionalidad"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="@string/hint_nacionalidad"
                        android:textColorHint="@color/text_secondary"
                        app:boxStrokeColor="@color/accent_purple"
                        app:hintTextColor="@color/accent_purple">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etNacionalidad"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapWords"
                            android:maxLength="30"
                            android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilFechaNacimiento"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="@string/hint_fecha_nacimiento"
                        android:textColorHint="@color/text_secondary"
                        app:boxStrokeColor="@color/accent_purple"
                        app:hintTextColor="@color/accent_purple">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etFechaNacimiento"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:digits="0123456789/"
                            android:inputType="number"
                            android:maxLength="10"
                            android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilNumeroDocumento"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="@string/hint_numero_documento"
                        android:textColorHint="@color/text_secondary"
                        app:boxStrokeColor="@color/accent_purple"
                        app:hintTextColor="@color/accent_purple">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etNumeroDocumento"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:digits="0123456789."
                            android:inputType="number"
                            android:maxLength="11"
                            android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilFechaEmision"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="@string/hint_fecha_emision"
                        android:textColorHint="@color/text_secondary"
                        app:boxStrokeColor="@color/accent_purple"
                        app:hintTextColor="@color/accent_purple">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etFechaEmision"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:digits="0123456789/"
                            android:inputType="number"
                            android:maxLength="10"
                            android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilFechaVencimiento"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="@string/hint_fecha_vencimiento"
                        android:textColorHint="@color/text_secondary"
                        app:boxStrokeColor="@color/accent_purple"
                        app:hintTextColor="@color/accent_purple">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etFechaVencimiento"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:digits="0123456789/"
                            android:inputType="number"
                            android:maxLength="10"
                            android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp"
                app:strokeColor="@color/chip_background"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="@string/form_seccion_condiciones"
                        android:textColor="@color/accent_stand"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/form_condiciones_ayuda"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/cbHipertension"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/cond_hipertension"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        app:buttonTint="@color/accent_stand" />
                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/cbDiabetes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/cond_diabetes"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        app:buttonTint="@color/accent_stand" />
                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/cbEpoc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/cond_epoc"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        app:buttonTint="@color/accent_stand" />
                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/cbErc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/cond_erc"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        app:buttonTint="@color/accent_stand" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp"
                app:strokeColor="@color/chip_background"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="@string/form_seccion_contacto"
                        android:textColor="@color/accent_stand"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilContactoNombre"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="@string/hint_contacto_nombre"
                        android:textColorHint="@color/text_secondary"
                        app:boxStrokeColor="@color/accent_purple"
                        app:hintTextColor="@color/accent_purple">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etContactoNombre"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPersonName|textCapWords"
                            android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilRelacion"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="@string/hint_relacion"
                        android:textColorHint="@color/text_secondary"
                        app:boxStrokeColor="@color/accent_purple"
                        app:hintTextColor="@color/accent_purple">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/etRelacion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilContactoTelefono"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="@string/hint_contacto_telefono"
                        android:textColorHint="@color/text_secondary"
                        app:boxStrokeColor="@color/accent_purple"
                        app:hintTextColor="@color/accent_purple"
                        app:counterEnabled="true"
                        app:counterMaxLength="8"
                        app:prefixText="+56 9 "
                        app:prefixTextColor="@color/text_secondary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etContactoTelefono"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLength="8"
                            android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/campos_obligatorios"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/btn_guardar"
            android:textColor="@color/text_primary"
            app:backgroundTint="@color/accent_exercise"
            app:cornerRadius="16dp" />

        <!-- NUEVO: cancelar la creación / edición -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelarFormulario"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="@string/btn_cancelar_formulario"
            android:textColor="@color/text_secondary"
            app:cornerRadius="16dp"
            app:strokeColor="@color/chip_background" />

        <ProgressBar
            android:id="@+id/progreso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:indeterminateTint="@color/accent_purple"
            android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
