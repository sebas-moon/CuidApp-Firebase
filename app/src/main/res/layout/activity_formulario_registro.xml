<?xml version="1.0" encoding="utf-8"?>
<!-- NUEVO: FORMULARIO DEL REGISTRO DIARIO (CREATE, READ, UPDATE y DELETE de un día).
     Las tarjetas de cada condición parten ocultas (gone) y la Activity muestra solo
     las que corresponden a las condiciones del paciente. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnVolverRegistro"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/desc_volver"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:id="@+id/tvTituloRegistro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/registro_titulo_nuevo"
                android:textColor="@color/text_primary"
                android:textSize="26sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvPacienteRegistro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:textColor="@color/accent_stand"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Juan Pérez · Hipertensión, Diabetes" />

        <!-- Aviso de SOLO LECTURA (registro con más de 24 horas) -->
        <TextView
            android:id="@+id/tvBloqueado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_chip"
            android:padding="12dp"
            android:text="@string/registro_bloqueado"
            android:textColor="@color/accent_yellow"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Hipertensión o Enfermedad renal: presión y pulso -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCardio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:strokeColor="@color/chip_background"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="@string/sec_cardio"
                        android:textColor="@color/accent_move"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilSistolica"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="@string/hint_sistolica"
                        android:textColorHint="@color/text_secondary"
                        app:boxStrokeColor="@color/accent_purple"
                        app:hintTextColor="@color/accent_purple">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etSistolica"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilDiastolica"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="@string/hint_diastolica"
                        android:textColorHint="@color/text_secondary"
                        app:boxStrokeColor="@color/accent_purple"
                        app:hintTextColor="@color/accent_purple">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDiastolica"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilFc"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="@string/hint_fc"
                        android:textColorHint="@color/text_secondary"
                        app:boxStrokeColor="@color/accent_purple"
                        app:hintTextColor="@color/accent_purple">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etFc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Diabetes: glucemia capilar -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDiabetes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:strokeColor="@color/chip_background"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="@string/sec_diabetes"
                        android:textColor="@color/accent_yellow"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilGlucemia"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="@string/hint_glucemia"
                        android:textColorHint="@color/text_secondary"
                        app:boxStrokeColor="@color/accent_purple"
                        app:hintTextColor="@color/accent_purple">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etGlucemia"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilMomento"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="@string/hint_momento"
                        android:textColorHint="@color/text_secondary"
                        app:boxStrokeColor="@color/accent_purple"
                        app:hintTextColor="@color/accent_purple">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/etMomento"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilInsulina"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="@string/hint_insulina"
                        android:textColorHint="@color/text_secondary"
                        app:boxStrokeColor="@color/accent_purple"
                        app:hintTextColor="@color/accent_purple">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etInsulina"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- EPOC / Asma: oxigenación -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardEpoc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:strokeColor="@color/chip_background"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="@string/sec_epoc"
                        android:textColor="@color/accent_stand"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilSaturacion"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="@string/hint_saturacion"
                        android:textColorHint="@color/text_secondary"
                        app:boxStrokeColor="@color/accent_purple"
                        app:hintTextColor="@color/accent_purple">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etSaturacion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilFr"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="@string/hint_fr"
                        android:textColorHint="@color/text_secondary"
                        app:boxStrokeColor="@color/accent_purple"
                        app:hintTextColor="@color/accent_purple">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etFr"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Enfermedad renal crónica: peso y diuresis -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardErc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:strokeColor="@color/chip_background"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="@string/sec_erc"
                        android:textColor="@color/accent_exercise"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilPesoDiario"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="@string/hint_peso_diario"
                        android:textColorHint="@color/text_secondary"
                        app:boxStrokeColor="@color/accent_purple"
                        app:hintTextColor="@color/accent_purple">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPesoDiario"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:digits="0123456789.,"
                            android:inputType="numberDecimal"
                            android:maxLength="5"
                            android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilDiuresis"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="@string/hint_diuresis"
                        android:textColorHint="@color/text_secondary"
                        app:boxStrokeColor="@color/accent_purple"
                        app:hintTextColor="@color/accent_purple">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDiuresis"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Bienestar general: SIEMPRE visible -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardGeneral"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:strokeColor="@color/chip_background"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="@string/sec_general"
                        android:textColor="@color/accent_purple"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/cbMedicacion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/registro_medicacion"
                        android:textColor="@color/text_primary"
                        app:buttonTint="@color/accent_purple" />

                    <TextView
                        android:id="@+id/tvDolor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        tools:text="Nivel de dolor (EVA 0-10): 0" />

                    <!-- Slider de 0 a 10, de a 1 (escala visual análoga del dolor) -->
                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderDolor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:contentDescription="@string/desc_slider_dolor"
                        android:stepSize="1"
                        android:value="0"
                        android:valueFrom="0"
                        android:valueTo="10"
                        app:thumbColor="@color/accent_purple"
                        app:trackColorActive="@color/accent_purple"
                        app:trackColorInactive="@color/chip_background" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilNotas"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="@string/hint_notas"
                        android:textColorHint="@color/text_secondary"
                        app:boxStrokeColor="@color/accent_purple"
                        app:hintTextColor="@color/accent_purple">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etNotas"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textMultiLine|textCapSentences"
                            android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/registro_rangos"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardarRegistro"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/btn_guardar_registro"
            android:textColor="@color/text_primary"
            app:backgroundTint="@color/accent_exercise"
            app:cornerRadius="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEliminarRegistro"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="@string/btn_eliminar_registro"
            android:textColor="@color/accent_move"
            android:visibility="gone"
            app:cornerRadius="16dp"
            app:strokeColor="@color/accent_move" />

        <ProgressBar
            android:id="@+id/progresoRegistro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:indeterminateTint="@color/accent_purple"
            android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
