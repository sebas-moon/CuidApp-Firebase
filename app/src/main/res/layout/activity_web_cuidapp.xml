<?xml version="1.0" encoding="utf-8"?>
<!-- NUEVO: pestaña Web, CuidApp Web dentro de un WebView -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnVolverWeb"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/desc_volver"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/web_titulo"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAbrirNavegador"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/web_abrir_navegador"
                android:textColor="@color/accent_stand" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progresoWeb"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:indicatorColor="@color/accent_purple"
        app:trackColor="@color/chip_background" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <WebView
            android:id="@+id/webCuidApp"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Sin internet: mensaje y botón para reintentar -->
        <LinearLayout
            android:id="@+id/panelErrorWeb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/web_sin_conexion"
                android:textColor="@color/text_secondary"
                android:textSize="16sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReintentarWeb"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:text="@string/web_reintentar"
                android:textColor="@color/text_primary"
                app:backgroundTint="@color/accent_purple"
                app:cornerRadius="14dp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
