<?xml version="1.0" encoding="utf-8"?>
<!-- NUEVO: tarjeta de UNA rutina de ejercicio -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/card_background"
    app:cardCornerRadius="20dp"
    app:cardElevation="4dp"
    app:strokeColor="@color/chip_background"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvEmojiRutina"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_circulo"
            android:gravity="center"
            android:textSize="24sp"
            tools:text="🚶" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombreRutina"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="Caminata suave" />

            <TextView
                android:id="@+id/tvDescripcionRutina"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                tools:text="Paso cómodo: debe poder conversar sin ahogarse." />

            <TextView
                android:id="@+id/tvMinutosRutina"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/accent_exercise"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="10 min" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnIniciarRutina"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/ejercicio_iniciar"
            android:textColor="@color/text_primary"
            app:backgroundTint="@color/accent_exercise"
            app:cornerRadius="14dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
