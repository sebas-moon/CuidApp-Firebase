// =====================================================================
// REGLAS DE SEGURIDAD DE CLOUD FIRESTORE - CuidApp
// Copiar en: Firebase Console > Firestore Database > Reglas > Publicar
// =====================================================================
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ¿Hay un usuario autenticado?
    function estaAutenticado() {
      return request.auth != null;
    }

    // ¿El usuario conectado es el cuidador dueño del paciente que YA existe?
    function esDueno() {
      return estaAutenticado() && resource.data.uid == request.auth.uid;
    }

    // Datos de la cédula: opcionales ("" si no se ingresaron)
    function textoOpcional(d, campo, maximo) {
      let v = d.get(campo, '');
      return v is string && v.size() <= maximo;
    }
    function fechaOpcional(d, campo) {
      let v = d.get(campo, '');
      return v is string && (v == '' || v.matches('[0-9]{2}/[0-9]{2}/[0-9]{4}'));   // dd/MM/yyyy
    }

    // Validación de los datos que se intentan escribir (repite las validaciones de la app)
    function pacienteValido() {
      let d = request.resource.data;
      return d.keys().hasOnly(['uid', 'nombre', 'rut', 'edad', 'sexo', 'peso', 'estatura',
                               'tipoSangre', 'condiciones', 'alergias', 'contactoNombre',
                               'contactoRelacion', 'contactoTelefono', 'fechaRegistro',
                               'nacionalidad', 'fechaNacimiento', 'numeroDocumento',
                               'fechaEmision', 'fechaVencimiento'])
          && d.nombre is string && d.nombre.size() >= 3 && d.nombre.size() <= 60
          && d.rut is string && d.rut.matches('[0-9]{7,8}-[0-9K]')        // 12345678-5
          && d.edad is int && d.edad >= 0 && d.edad <= 120
          && d.sexo in ['Femenino', 'Masculino', 'Otro']
          && d.peso is number && d.peso >= 2 && d.peso <= 300
          && d.estatura is int && d.estatura >= 30 && d.estatura <= 250
          && d.tipoSangre in ['O+', 'O-', 'A+', 'A-', 'B+', 'B-', 'AB+', 'AB-']
          && d.condiciones is list && d.condiciones.size() <= 4
          && d.condiciones.hasOnly(['HIPERTENSION', 'DIABETES', 'EPOC', 'ERC'])
          && d.alergias is string && d.alergias.size() <= 100
          && d.contactoNombre is string && d.contactoNombre.size() >= 3 && d.contactoNombre.size() <= 60
          && d.contactoRelacion is string && d.contactoRelacion.size() <= 30
          && d.contactoTelefono is string && d.contactoTelefono.matches('[+]569[0-9]{8}')   // +56 9 y 8 dígitos
          && textoOpcional(d, 'nacionalidad', 30)
          && fechaOpcional(d, 'fechaNacimiento')
          && (d.get('numeroDocumento', '') == '' || d.numeroDocumento.matches('[0-9]{3}[.][0-9]{3}[.][0-9]{3}|[0-9]{9}'))
          && fechaOpcional(d, 'fechaEmision')
          && fechaOpcional(d, 'fechaVencimiento');
    }

    // ---- Pacientes: cada cuidador solo ve y modifica LOS SUYOS ----
    match /pacientes/{pacienteId} {
      // get = leer UN documento. resource == null: no existe (ej. recién eliminado); no revela datos
      allow get: if estaAutenticado() && (resource == null || resource.data.uid == request.auth.uid);
      // list = consultas. La app SIEMPRE filtra whereEqualTo("uid", miUid); si no, se rechaza
      allow list: if estaAutenticado() && resource.data.uid == request.auth.uid;
      allow delete: if esDueno();
      allow create: if estaAutenticado()
                    && request.resource.data.uid == request.auth.uid
                    && pacienteValido();
      allow update: if esDueno()
                    && request.resource.data.uid == resource.data.uid   // no se puede traspasar el paciente
                    && pacienteValido();

      // ---- Registros diarios: SUBCOLECCIÓN pacientes/{pacienteId}/registros/{fecha} ----
      match /registros/{fecha} {

        // ¿El paciente "padre" pertenece al usuario conectado? (get() lee otro documento)
        function duenoDelPaciente() {
          return get(/databases/$(database)/documents/pacientes/$(pacienteId)).data.uid == request.auth.uid;
        }

        // BLOQUEO CLÍNICO: solo dentro de las 24 h desde que el SERVIDOR lo creó
        function dentroDe24h() {
          return request.time < resource.data.creado + duration.value(24, 'h');
        }

        // Número opcional (null = sección no aplica al paciente) dentro de un rango
        function numeroOpcional(d, campo, min, max) {
          let v = d.get(campo, null);
          return v == null || (v is number && v >= min && v <= max);
        }

        function registroValido() {
          let d = request.resource.data;
          return d.keys().hasOnly(['uid', 'pacienteId', 'fecha', 'creado',
                                   'sistolica', 'diastolica', 'frecuenciaCardiaca',
                                   'glucemia', 'momentoGlucemia', 'insulina',
                                   'saturacion', 'frecuenciaRespiratoria',
                                   'pesoDiario', 'diuresis',
                                   'medicacionTomada', 'dolor', 'notas', 'alertas'])
              && numeroOpcional(d, 'sistolica', 60, 250)
              && numeroOpcional(d, 'diastolica', 30, 150)
              && numeroOpcional(d, 'frecuenciaCardiaca', 30, 220)
              && numeroOpcional(d, 'glucemia', 20, 600)
              && numeroOpcional(d, 'insulina', 0, 100)
              && numeroOpcional(d, 'saturacion', 50, 100)
              && numeroOpcional(d, 'frecuenciaRespiratoria', 5, 60)
              && numeroOpcional(d, 'pesoDiario', 2, 300)
              && numeroOpcional(d, 'diuresis', 0, 5000)
              && (d.get('momentoGlucemia', null) == null
                  || d.momentoGlucemia in ['Ayunas', 'Antes de comer', '2 h después de comer', 'Antes de dormir'])
              && d.medicacionTomada is bool
              && d.dolor is int && d.dolor >= 0 && d.dolor <= 10
              && (d.get('notas', null) == null || (d.notas is string && d.notas.size() <= 300))
              && d.alertas is list && d.alertas.size() <= 15;
        }

        allow get: if estaAutenticado() && (resource == null || resource.data.uid == request.auth.uid);
        allow list: if estaAutenticado() && resource.data.uid == request.auth.uid;

        // CREATE: un registro por día (ID = fecha), del paciente propio, con hora del servidor
        allow create: if estaAutenticado()
                      && request.resource.data.uid == request.auth.uid
                      && duenoDelPaciente()
                      && request.resource.data.fecha == fecha
                      && request.resource.data.pacienteId == pacienteId
                      && request.resource.data.creado == request.time
                      && registroValido();

        // UPDATE: solo el dueño, solo antes de 24 h y sin tocar los datos de identidad
        allow update: if esDueno()
                      && dentroDe24h()
                      && request.resource.data.diff(resource.data).unchangedKeys()
                             .hasAll(['uid', 'pacienteId', 'fecha', 'creado'])
                      && registroValido();

        // DELETE: antes de 24 h... o cuando se elimina el paciente completo (borrado en cascada).
        // existsAfter() mira cómo queda la base DESPUÉS del lote: si el paciente ya no existe, se permite.
        allow delete: if esDueno()
                      && (dentroDe24h()
                          || !existsAfter(/databases/$(database)/documents/pacientes/$(pacienteId)));
      }
    }

    // ---- Perfil del cuidador: el ID del documento ES su UID. Nunca guarda contraseña ----
    match /usuarios/{userId} {
      allow read, delete: if estaAutenticado() && request.auth.uid == userId;
      allow create, update: if estaAutenticado() && request.auth.uid == userId
                            && request.resource.data.keys().hasOnly(['nombre', 'correo', 'fechaCreacion']);
    }

    // ---- Todo lo demás: CERRADO ----
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
